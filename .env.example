# Central configuration. Copy to `.env` and edit. Switching this stack from
# localhost to a public VPS domain requires changing ONLY this file.

# --- Domain -------------------------------------------------------------
# Root domain the reverse proxy serves. The osu! client is launched with
# `-devserver <DOMAIN>` and internally derives c.<DOMAIN>, osu.<DOMAIN>, and
# a.<DOMAIN> for Bancho, score submission/maps, and avatars respectively.
DOMAIN=localhost

# --- Database -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=bancho
MYSQL_USER=bancho
MYSQL_PASSWORD=changeme

# --- Backend ---------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=bancho
DB_PASSWORD=changeme
DB_NAME=bancho
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=changeme-please-use-a-long-random-value
SERVER_NAME=my-private-server

# --- Frontend ---------------------------------------------------------------
# Leave empty (default): the website calls its own API same-origin through
# Caddy's /api/* route (see proxy/Caddyfile), so no domain/scheme needs to
# be configured here for local dev or most VPS deployments. Only set this
# if the frontend is served from a different host than the API.
NEXT_PUBLIC_API_BASE_URL=
