# Central configuration. Copy to `.env` and edit. Switching this stack from
# localhost to a public VPS domain requires changing ONLY this file.

# --- Domain -------------------------------------------------------------
# Root domain the reverse proxy serves. The osu! client is launched with
# `-devserver <DOMAIN>` and internally derives c.<DOMAIN>, osu.<DOMAIN>, and
# a.<DOMAIN> for Bancho, score submission/maps, and avatars respectively.
DOMAIN=localhost

# --- Database -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=bancho
MYSQL_USER=bancho
MYSQL_PASSWORD=changeme

# --- Backend ---------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=bancho
DB_PASSWORD=changeme
DB_NAME=bancho
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=changeme-please-use-a-long-random-value
SERVER_NAME=my-private-server

# --- Frontend ---------------------------------------------------------------
# Reachable from the *browser*, so this must be the public osu.<DOMAIN> host,
# not the internal Docker service name. Matches the Caddyfile, which serves
# plain HTTP only for local dev (see proxy/Caddyfile) - use https:// here
# only after switching DOMAIN to a real public domain with Caddy's automatic
# HTTPS restored.
NEXT_PUBLIC_API_BASE_URL=http://osu.localhost
